{
  "compilerOptions": {
    "target": "ESNext", // Support latest JS features
    "module": "ESNext", // Use ES modules
    "moduleResolution": "bundler", // Resolve imports the way Vite does
    "lib": ["DOM", "ESNext"], // Support browser and latest JS
    "declaration": true, // Generate .d.ts files
    "outDir": "dist", // Where compiled files go
    "rootDir": "./src", // Required by TS 6 when emitting (outDir/declaration)
    "strict": true, // Enable all strict type checks
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}