{
  "name": "sb-floating-panel-vue",
  "version": "5.3.1",
  "description": "Headless Vue 3 floating panel components (dropdowns, popovers, menus) powered by @floating-ui/vue: positioning, accessibility and open state handled, zero CSS shipped.",
  "keywords": [
    "vue",
    "vue3",
    "floating-ui",
    "floating panel",
    "popover",
    "dropdown",
    "menu",
    "floating",
    "positioning",
    "headless",
    "unstyled",
    "teleport",
    "accessibility",
    "vue-components",
    "vue-library"
  ],
  "author": {
    "name": "Stefano Biddau",
    "url": "https://www.stefano-biddau.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanBid/sb-floating-panel-vue"
  },
  "bugs": {
    "url": "https://github.com/stefanBid/sb-floating-panel-vue/issues"
  },
  "homepage": "https://github.com/stefanBid/sb-floating-panel-vue#readme",
  "main": "dist/sb-floating-panel.umd.js",
  "module": "dist/sb-floating-panel.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sb-floating-panel.es.js",
      "require": "./dist/sb-floating-panel.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.playground.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@floating-ui/vue": "^2.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@types/node": "^26.6.11",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vue/language-core": "^3.3.14",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "_comment_dependencies": {
    "typescript": "held at 6.x: TypeScript 7 waits for @typescript-eslint/parser and eslint-plugin to accept it in their peers (still <6.1.0 in 8.74.0) (note typescript@7.0.2)",
    "minimatch": "transitive, dev only: advisories GHSA-g3hv-75wg-m249 / GHSA-3g3m-2fjr-6pw4 come through @vue/test-utils -> js-beautify 2.0.3, which still uses minimatch 10.x; npm only offers a downgrade (note minimatch@11.0.1)"
  }
}
