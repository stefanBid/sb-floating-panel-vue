{
  "name": "sb-floating-panel-vue",
  "version": "5.0.3",
  "description": "Headless Vue 3 floating panel components (dropdowns, popovers, menus) powered by @floating-ui/vue: positioning, accessibility and open state handled, zero CSS shipped.",
  "keywords": [
    "vue",
    "vue3",
    "floating-ui",
    "floating panel",
    "popover",
    "dropdown",
    "menu",
    "floating",
    "positioning",
    "headless",
    "unstyled",
    "teleport",
    "accessibility",
    "vue-components",
    "vue-library"
  ],
  "author": {
    "name": "Stefano Biddau",
    "url": "https://www.stefano-biddau.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanBid/sb-floating-panel-vue"
  },
  "bugs": {
    "url": "https://github.com/stefanBid/sb-floating-panel-vue/issues"
  },
  "homepage": "https://github.com/stefanBid/sb-floating-panel-vue#readme",
  "main": "dist/sb-floating-panel.umd.js",
  "module": "dist/sb-floating-panel.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sb-floating-panel.es.js",
      "require": "./dist/sb-floating-panel.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.playground.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@floating-ui/vue": "^2.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
